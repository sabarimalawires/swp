generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// SWP ENUMS
// ============================================================

enum UserRole {
  ADMIN
  WORKER
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
}

enum WorkStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SaleStatus {
  ACTIVE
  VOIDED
}

enum InventoryTransactionType {
  INITIAL_STOCK
  PRODUCTION
  SALE
  STOCK_ADJUSTMENT_ADD
  STOCK_ADJUSTMENT_REMOVE
  SALE_VOID
  PRODUCTION_REVERSAL
}

enum ReferenceType {
  INITIAL_STOCK
  WORK_ENTRY
  SALE
  STOCK_ADJUSTMENT
  SALE_VOID
  WORK_ENTRY_EDIT
}

enum AuditAction {
  CREATE
  UPDATE
  DEACTIVATE
  REACTIVATE
  APPROVE
  REJECT
  VOID
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  PASSWORD_RESET
  DELETE
}

enum AuditEntityType {
  USER
  PRODUCT
  WORK_ENTRY
  SALE
  INVENTORY
  CUSTOMER
  CUSTOMER_PAYMENT
  CUSTOMER_LEDGER_OPENING_BALANCE
}

// ============================================================
// BETTER AUTH
// ============================================================

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  username String? @unique

  sessions Session[]
  accounts Account[]

  employee Employee?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id         String @id
  accountId  String
  providerId String
  issuer     String
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken  String?
  refreshToken String?
  idToken      String?

  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?

  scope    String?
  password String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ============================================================
// SWP EMPLOYEE / BUSINESS PROFILE
// ============================================================

model Employee {
  id String @id @default(cuid())

  // Links this business profile to Better Auth's User.
  authUserId String @unique
  authUser   User   @relation(fields: [authUserId], references: [id], onDelete: Cascade)

  username String @unique
  name     String

  role   UserRole
  status UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workEntries           WorkEntry[]            @relation("WorkerWorkEntries")
  approvedWorkEntries   WorkEntry[]            @relation("ApprovedBy")
  createdSales          Sale[]                 @relation("SalesCreatedBy")
  voidedSales           Sale[]                 @relation("SalesVoidedBy")
  inventoryTransactions InventoryTransaction[]
  auditLogs             AuditLog[]
  changedWorkVersions   WorkEntryVersion[]
  customerPayments      CustomerPayment[]      @relation("PaymentsCreatedBy")

  @@index([role])
  @@index([status])
}

// ============================================================
// CUSTOMERS
// ============================================================

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales                 Sale[]
  payments              CustomerPayment[]
  ledgerOpeningBalances CustomerLedgerOpeningBalance[]

  @@index([name])
  @@index([phone])
}

// ============================================================
// PRODUCTS
// ============================================================

model Product {
  id   String  @id @default(cuid())
  name String  @unique
  code String? @unique

  // Inventory is tracked in kilograms
  initialStockKg      Decimal @default(0) @db.Decimal(14, 3)
  lowStockThresholdKg Decimal @default(0) @db.Decimal(14, 3)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workEntries           WorkEntry[]
  sales                 Sale[]
  inventoryTransactions InventoryTransaction[]
  saleItems             SaleItem[]

  @@index([isActive])
}

// ============================================================
// WORK ENTRIES
// ============================================================

model WorkEntry {
  id String @id @default(cuid())

  workerId  String
  productId String

  quantity Int
  // Weight produced by the worker, in kilograms.
  weight   Decimal @default(0) @db.Decimal(14, 3)

  status WorkStatus @default(PENDING)

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  approvedAt      DateTime?
  approvedById    String?
  rejectionReason String?

  worker     Employee  @relation("WorkerWorkEntries", fields: [workerId], references: [id])
  product    Product   @relation(fields: [productId], references: [id])
  approvedBy Employee? @relation("ApprovedBy", fields: [approvedById], references: [id])

  versions              WorkEntryVersion[]
  inventoryTransactions InventoryTransaction[]

  @@index([workerId])
  @@index([productId])
  @@index([status])
  @@index([submittedAt])
}

// ============================================================
// WORK ENTRY HISTORY
// ============================================================

model WorkEntryVersion {
  id String @id @default(cuid())

  workEntryId String
  quantity    Int

  // Weight recorded for this version, in kilograms.
  weight Decimal @default(0) @db.Decimal(14, 3)

  changedById String
  changedAt   DateTime @default(now())

  reason String?

  workEntry WorkEntry @relation(fields: [workEntryId], references: [id], onDelete: Cascade)
  changedBy Employee  @relation(fields: [changedById], references: [id])

  @@index([workEntryId])
  @@index([changedAt])
}

// ============================================================
// SALES
// ============================================================

model Sale {
  id String @id @default(cuid())

  customerId String
  productId  String

  quantity Int

  // Weight of the product sold, stored in Kilograms.
  weight Decimal @db.Decimal(12, 3)

  // Total sale amount in the business currency (INR).
  amount Decimal @db.Decimal(14, 2)

  saleDate DateTime
  status   SaleStatus @default(ACTIVE)

  createdById String
  createdAt   DateTime @default(now())

  voidedById String?
  voidedAt   DateTime?

  customer Customer @relation(fields: [customerId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  createdBy Employee  @relation("SalesCreatedBy", fields: [createdById], references: [id])
  voidedBy  Employee? @relation("SalesVoidedBy", fields: [voidedById], references: [id])

  inventoryTransactions InventoryTransaction[]
  payments              CustomerPayment[]
  items                 SaleItem[]

  @@index([customerId])
  @@index([productId])
  @@index([saleDate])
  @@index([status])
  @@index([createdById])
}

model SaleItem {
  id        String @id @default(cuid())
  saleId    String
  productId String

  // Preserve historical unit-based deductions.
  deductedQuantity Int @default(0)

  // Actual stock deducted, measured in kilograms.
  deductedWeight Decimal @default(0) @db.Decimal(14, 3)

  productName String
  quantity    Int
  weight      Decimal @db.Decimal(12, 3)
  rate        Decimal @db.Decimal(14, 6)
  amount      Decimal @db.Decimal(14, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
}

model CustomerLedgerOpeningBalance {
  id                 String   @id @default(cuid())
  customerId         String
  financialYearStart DateTime @db.Date
  openingBalance     Decimal  @db.Decimal(14, 2)
  isManualOverride   Boolean  @default(false)
  overrideReason     String?
  updatedById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@unique([customerId, financialYearStart])
  @@index([financialYearStart])
  @@map("customer_ledger_opening_balances")
}

// ============================================================
// CUSTOMER PAYMENTS
// ============================================================

model CustomerPayment {
  id String @id @default(cuid())

  customerId String

  // Optional because a payment can either be linked to a
  // specific sale or treated as a general customer payment.
  saleId String?

  // Payment amount in INR.
  amount Decimal @db.Decimal(14, 2)

  paymentDate DateTime @default(now())

  note String?

  createdById String
  createdAt   DateTime @default(now())

  customer  Customer @relation(fields: [customerId], references: [id])
  sale      Sale?    @relation(fields: [saleId], references: [id])
  createdBy Employee @relation("PaymentsCreatedBy", fields: [createdById], references: [id])

  @@index([customerId])
  @@index([saleId])
  @@index([paymentDate])
  @@index([createdById])
}

// ============================================================
// INVENTORY LEDGER
// ============================================================

model InventoryTransaction {
  id String @id @default(cuid())

  productId String

  type     InventoryTransactionType
  quantity Int
  // Positive weight amount in kilograms.
  // The transaction type determines whether stock increases or decreases.
  weight   Decimal                  @default(0) @db.Decimal(14, 3)

  referenceType ReferenceType
  referenceId   String

  createdById String
  createdAt   DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id])
  createdBy Employee @relation(fields: [createdById], references: [id])

  workEntry WorkEntry? @relation(fields: [workEntryId], references: [id])
  sale      Sale?      @relation(fields: [saleId], references: [id])

  workEntryId String?
  saleId      String?

  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@index([referenceId])
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id String @id @default(cuid())

  userId String?

  action     AuditAction
  entityType AuditEntityType
  entityId   String

  oldValue Json?
  newValue Json?

  createdAt DateTime @default(now())

  user Employee? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
